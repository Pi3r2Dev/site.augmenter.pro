# Copier en .env.local (dev) et déclarer les mêmes clés côté Hostinger (prod).
# Aucune valeur réelle ne doit être commitée : .env.local est gitignoré.

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# ── LiteLLM (génération du brief du wizard de devis) ─────────────────────────
# Si absent, le wizard bascule sur buildClientFallbackBrief() — pas d'erreur.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# ── Réception des demandes de devis (/api/quote) ─────────────────────────────
# La demande est TOUJOURS écrite dans les logs applicatifs (préfixe [QUOTE]),
# même sans aucune des variables ci-dessous. Elles ajoutent des canaux d'alerte.

# Webhook POST (n8n, Make, Zapier…) — reçoit la demande complète en JSON.
# Sert aussi aux abandons de wizard (/api/notify-abandon).
NOTIFY_WEBHOOK_URL=

# Alerte e-mail via Resend. Les trois doivent être présentes pour être actives.
# QUOTE_FROM_EMAIL doit être sur un domaine vérifié dans Resend.
RESEND_API_KEY=
QUOTE_NOTIFY_EMAIL=vite@augmenter.pro
QUOTE_FROM_EMAIL=devis@augmenter.pro

# ── Portail client (/clients/<client>) ───────────────────────────────────────
# Les trois sont obligatoires en prod (hPanel). Sans elles : login refusé
# (?err=config) ou document indisponible (503) — jamais de secret par défaut.

# Code d'accès remis au client Reva 9 (8+ caractères, sans indice sur le client).
PORTAL_REVA9_PASSCODE=

# Signature HMAC du cookie de session (30 j). 32+ caractères : openssl rand -hex 32
PORTAL_COOKIE_SECRET=

# Clé AES-256 (64 hex) ayant chiffré src/content/portal/**/*.ts via
# scripts/portal-encrypt.mjs. DOIT être identique en dev et en prod : openssl rand -hex 32
PORTAL_CONTENT_KEY=
