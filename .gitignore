# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# MCP config (contains credentials)
.mcp.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/
/public/_next/
/_next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
nul
.playwright-mcp/
Home.html

# Docs personnels — gardés en local, jamais sur le repo (repo privé séparé prévu)
/LE-FOUR_scenario-prudent.md
/docs/CV_PL/
/docs/IdeaBox/
/docs/ClaudeDesign_handoff/design_handoff_hero_augmente/

# Artefacts de dev jetables à la racine (previews GBP, snapshots) — jamais commités
/gbp-*.png
/snap-*.yml

# Portail client : jamais de HTML en clair — seuls les modules chiffrés *.ts sont versionnés
/src/content/portal/**/*.html
